{
  "name": "ccpulse",
  "version": "0.3.0",
  "description": "Understand, learn from and forecast your Claude Code usage: cycle pace vs. limits, forecasts, anomaly alerts and a local dashboard.",
  "keywords": [
    "admin-api",
    "anomaly-detection",
    "budget",
    "ccusage",
    "claude",
    "claude-code",
    "cost",
    "dashboard",
    "finops",
    "forecast",
    "monte-carlo",
    "rate-limit",
    "subscription",
    "tokens",
    "usage"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "ccpulse": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test dist/core.test.js dist/pro.test.js",
    "dev": "npm run build && node dist/cli.js",
    "prepack": "npm run build",
    "shots": "npm run build && node scripts/shots.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taflynx/ccpulse.git"
  },
  "homepage": "https://github.com/Taflynx/ccpulse#readme",
  "bugs": {
    "url": "https://github.com/Taflynx/ccpulse/issues"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.8.0"
  }
}
